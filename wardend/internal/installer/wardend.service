[Unit]
Description=Warden daemon (Minecraft server manager)
Documentation=https://github.com/manuelvegadev/warden
After=network.target

[Service]
Type=simple
User=warden
Group=warden
EnvironmentFile=/etc/warden/wardend.env
ExecStart=/usr/local/bin/wardend
Restart=on-failure
RestartSec=5s
# wardend stops every server in stages (stop -> SIGTERM -> SIGKILL) before exiting.
TimeoutStopSec=150
KillMode=mixed
LimitNOFILE=65536

# Hardening: only the data directory is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{DATA_DIR}}
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Binding :443/:80 for Let's Encrypt.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

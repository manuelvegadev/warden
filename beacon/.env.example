# --- Better Auth ---
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=   # orígenes extra separados por coma (normalmente vacío)
DATABASE_PATH=./data/beacon.db # en Docker: /data/beacon.db (volumen)
BEACON_OPEN_SIGNUP=false       # true solo para permitir auto-registro (el primer usuario siempre es admin)
# Discord OAuth (opcional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- wardend ---
WARDEND_URL=http://localhost:8080            # URL interna (servidor→servidor)
WARDEND_PANEL_KEY=                           # openssl rand -hex 32 ; mismo valor en wardend
NEXT_PUBLIC_WARDEND_WS_URL=ws://localhost:8080  # URL pública para el WebSocket del navegador (wss:// en prod)

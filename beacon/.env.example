# --- Better Auth ---
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=   # extra origins, comma-separated (usually empty)
DATABASE_PATH=./data/beacon.db # in Docker: /data/beacon.db (volume)
BEACON_OPEN_SIGNUP=false       # true only to allow self-signup (the first user is always admin)
# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- wardend ---
WARDEND_URL=http://localhost:8080            # internal URL (server-to-server)
WARDEND_PANEL_KEY=                           # openssl rand -hex 32 ; same value in wardend
NEXT_PUBLIC_WARDEND_WS_URL=ws://localhost:8080  # public URL for the browser WebSocket (wss:// in prod)

# --- Better Auth ---
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=   # extra origins, comma-separated (usually empty)
DATABASE_PATH=./data/beacon.db # in Docker: /data/beacon.db (volume)
BEACON_OPEN_SIGNUP=false       # true only to allow self-signup (the first user is always admin)
# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- wardend ---
WARDEND_URL=http://localhost:8080            # server-to-server URL; https://mc.example.com:8443 in prod
#NODE_EXTRA_CA_CERTS=/data/wardend.crt       # only when wardend uses WARDEND_TLS=self-signed
WARDEND_PANEL_KEY=                           # openssl rand -hex 32 ; same value in wardend
WARDEND_PUBLIC_WS_URL=ws://localhost:8080    # public wardend URL the browser opens the WebSocket to (wss://… in prod); runtime env
NEXT_PUBLIC_WARDEND_WS_URL=ws://localhost:8080  # development fallback for the same value
# Shown in the sidebar; the Docker build sets it from the release tag / commit (Dockerfile ARG VERSION).
#NEXT_PUBLIC_BEACON_VERSION=dev

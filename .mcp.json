{
  "mcpServers": {
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "shadcn": {
      "command": "pnpm",
      "args": ["--dir", "beacon", "dlx", "shadcn@latest", "mcp"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "gopls": {
      "command": "gopls",
      "args": ["mcp"],
      "env": { "PATH": "${HOME}/go/bin:/usr/local/go/bin:/opt/homebrew/bin:/usr/bin:/bin" }
    }
  }
}

# /etc/warden/wardend.env — environment for the wardend systemd unit (root-only file).
# This file is the reference for every WARDEND_* variable; docs/deploy.md explains the setup.

# Bind address. Use :443 with WARDEND_TLS=acme; otherwise a private port behind the firewall.
WARDEND_LISTEN=:8443
WARDEND_DATA_DIR=/var/lib/warden
WARDEND_LOG_LEVEL=info
# Contact for the User-Agent sent to PaperMC/Hangar/Modrinth/Mojang (they ask for one).
WARDEND_CONTACT=admin@example.com

# --- Panel trust (ADR-009). ---
# Beacon's public URL; its JWKS is fetched from <issuer>/api/auth/jwks (WARDEND_PANEL_JWKS_URL overrides).
WARDEND_PANEL_ISSUER=https://beacon.example.com
# Shared secret, same value as WARDEND_PANEL_KEY in Beacon.  openssl rand -hex 32
WARDEND_PANEL_KEY=
# Origins allowed to open the WebSocket (the browser connects to wardend directly).
WARDEND_ALLOWED_ORIGINS=https://beacon.example.com
# This node's id in Beacon (ADR-017). Leave as `default` unless Beacon drives several daemons;
# it must match Beacon's WARDEND_NODE_ID, or every token is rejected as minted for another node.
WARDEND_NODE_ID=default

# --- TLS: off | files | acme | self-signed (docs/deploy.md#tls-modes). ---
WARDEND_TLS=acme
WARDEND_TLS_HOSTS=mc.example.com          # acme: domains; self-signed: extra names/IPs
WARDEND_TLS_EMAIL=admin@example.com       # acme account contact
#WARDEND_TLS_CERT=/etc/letsencrypt/live/mc.example.com/fullchain.pem   # files mode
#WARDEND_TLS_KEY=/etc/letsencrypt/live/mc.example.com/privkey.pem
# acme: challenge + redirect listener; set to empty (WARDEND_TLS_HTTP_ADDR=) when :80 is taken.
WARDEND_TLS_HTTP_ADDR=:80

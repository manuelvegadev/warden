# Environment for the Beacon container (docker run --env-file deploy/beacon.env …).
# `wardend install` writes these itself when you let it run Beacon; use this file to run the
# panel by hand or on another host (Dokploy → paste as environment variables).

# Secret for sessions/JWT signing.  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser-facing URL of the panel. It is also the JWT issuer wardend expects (WARDEND_PANEL_ISSUER).
BETTER_AUTH_URL=http://server.local:3000
# SQLite inside the /data volume; the schema is migrated automatically on start.
DATABASE_PATH=/data/beacon.db
# The first account is always admin; keep false so nobody else can self-register.
BEACON_OPEN_SIGNUP=false

# --- wardend ---
# Server-to-server URL. From a container on the same box: https://host.docker.internal:8444
# (run with --add-host host.docker.internal:host-gateway); elsewhere: the daemon's public URL.
WARDEND_URL=https://host.docker.internal:8444
# Same value as WARDEND_PANEL_KEY in /etc/warden/wardend.env.
WARDEND_PANEL_KEY=
# What the browser opens for the console WebSocket: the daemon's public URL with ws(s)://.
WARDEND_PUBLIC_WS_URL=wss://server.local:8444
# Only when wardend uses WARDEND_TLS=self-signed: mount the cert and trust it in Node.
#NODE_EXTRA_CA_CERTS=/certs/wardend.crt
